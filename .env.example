
# Opret en app på https://developer.spotify.com/dashboard og indsæt Client ID herunder.
# Redirect URI i Spotify-appens indstillinger skal matche VITE_SPOTIFY_REDIRECT_URI
# (eller "http://127.0.0.1:5173/callback" som er default i dev).
VITE_SPOTIFY_CLIENT_ID=

# Valgfri — falder tilbage til "<origin>/callback" hvis udeladt.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Opret en gratis API-nøgle på https://www.last.fm/api/account/create
# (kræver ingen godkendelse, virker med det samme). Bruges af
# LastFmRecommendationProvider til artist.getsimilar/artist.gettoptracks.
VITE_LASTFM_API_KEY=
